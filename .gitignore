# ==========================================
# DevSecOps Strict Repository Security Protocol
# ==========================================

# 1. Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.template

# 2. Cryptographic Keys & Certificates
*.pem
*.cer
*.crt
*.key
*.jks
*.p12
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# 3. Service Accounts & Credential Dumps
*.json
!package.json
!package-lock.json
!tsconfig.json
!public/manifest.json

# 4. Database Dumps & PII
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
dump.csv

# 5. Dependencies & Package Managers
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 6. Build Artifacts & Caches
/.next/
/out/
/build/
/dist/
/coverage
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc
*.class
venv/
env/

# 7. OS System & Debug Files
.DS_Store
Thumbs.db
desktop.ini
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
